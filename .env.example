# ════════════════════════════════════════════════════════════════════
# Variables d'environnement — copier ce fichier en .env.local
# (ne JAMAIS commit .env.local : il contient des secrets)
# ════════════════════════════════════════════════════════════════════

# ─── TinaCMS (édition du contenu via /admin) ───
# Récupérables sur https://app.tina.io → projet → "Overview"
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# ─── Newsletter Systeme.io (formulaire /contact) ───
# Clé API Systeme.io : Settings → Public API keys
systeme_api_key=
# ID numérique du tag à attacher aux nouveaux contacts
# (ex: "Newsletter Florence Naturopathe")
systeme_tag_id=
